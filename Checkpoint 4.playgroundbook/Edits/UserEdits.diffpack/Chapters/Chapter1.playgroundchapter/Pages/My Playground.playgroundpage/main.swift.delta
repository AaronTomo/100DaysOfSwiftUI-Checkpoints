			<string>//Checkpoint 4

enum errors : Error {
    case outOfBounds, noRoot
}


func squareRoot(_ num: Int) throws -&gt; Int {
    if num &lt; 1 || num &gt; 10_000 {
        throw errors.outOfBounds
    }
    
    for i in 1...1000 {
        if(i*i == num){
            return i
        }
    }
    
    throw errors.noRoot
}


do{
    let sqRtNum = 100
    let result = try squareRoot(sqRtNum)
    print("The square root of \(sqRtNum) is \(result)")
}catch(errors.noRoot){
    print("No sqaure root number was found")
}catch(errors.outOfBounds){
    print("Error, please use a number between 1-10,000")
}catch{
    print("An error occured")
}
</string>
