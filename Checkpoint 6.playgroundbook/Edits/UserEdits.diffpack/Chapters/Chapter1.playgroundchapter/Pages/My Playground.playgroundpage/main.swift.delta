			<string>//Checkpoint 6

struct Car {
    let model: String
    let seats: Int
    private var currentGear: Int = 1 {
        didSet {
            print("Gear is now \(currentGear)")
        }
    }
    
    init(model: String, seats: Int){
        self.model = model
        self.seats = seats
    }
    
    func showCurrentGear(){
        print("Current gear is set to \(currentGear)")
    }
    
    mutating func changeGearDown(){
        if currentGear &lt;= 1 { 
            print("Can't go any lower")
        }else {
             currentGear -= 1   
        }
    }
    
    mutating func changeGearUp(){
        if currentGear &gt;= 10 { 
            print("Can't go any higher")    
        } else {
             currentGear += 1   
        }
    }
}

var Tesla = Car(model: "Model S", seats: 4)
Tesla.showCurrentGear()
Tesla.changeGearDown()
for _ in 1...11 {
    Tesla.changeGearUp()
}
</string>
