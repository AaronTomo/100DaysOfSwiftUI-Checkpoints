			<string>//Checkpoint 7


class Animal {
    var noOfLegs: Int
    
    init(noOfLegs: Int){
        self.noOfLegs = noOfLegs
    }
}

class Dog : Animal {
    func speak(){
        print("Woof")
    }
}

class Corgi : Dog {
    override func speak(){
        print("Woof in corgi")
    }
}

class Cat : Animal {
    var isTame: Bool
    
    init(noOfLegs: Int, isTame: Bool){
        self.isTame = isTame
        super.init(noOfLegs: noOfLegs)
    }
    
    func speak(){
        print("Meow")
    }
}

class Lion : Cat {
    override func speak(){
        print("Roar!!")
    }
}

let lion = Lion(noOfLegs: 4, isTame: false)
print("\(lion.noOfLegs)")
print("\(lion.isTame)")
lion.speak()

let alfred = Corgi(noOfLegs: 4)
alfred.speak()
