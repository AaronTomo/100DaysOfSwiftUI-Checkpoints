			<string>//Checkpoint 8 

protocol Building {
    var rooms: Int { get set }
    var cost: Int { get set }
    var estateAgentName : String { get set }
    
    func summary() -&gt; Void
}

struct Office : Building {
    var rooms: Int
    var cost: Int
    var estateAgentName: String

    
    func summary() {
        print(
            """
            Summary of Office.
            Number of rooms: \(rooms)
            Cost of the project: \(cost)
            Estate agent name: \(estateAgentName)
            """
        )
    }
}

struct House : Building {
    var rooms: Int
    var cost: Int
    var estateAgentName: String

    func summary() {
        print(
            """
            Summary of house.
            Number of rooms: \(rooms)
            Cost of the project: \(cost)
            Estate agent name: \(estateAgentName)
            """
        )
    }

    
}


let o = Office(rooms: 24, cost: 1_000_000, estateAgentName: "Aaron estate Agent")
o.summary()

let h = House(rooms: 5, cost: 66_000, estateAgentName: "Local House Agent")
h.summary()


